NODE_ENV=production
HOST=127.0.0.1
PORT=8080
MONGODB_URI=mongodb://binary-server:change-me@127.0.0.1:27017/binary_database?authSource=admin
BINARY_STORAGE_ROOT=/var/lib/binary-server/artifacts
BINARY_SERVER_TOKEN=replace-with-a-random-token-at-least-32-characters-long
MAX_UPLOAD_BYTES=524288000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# Development preview only. Do not enable in NODE_ENV=production.
# PLATFORM_API_ENABLED=true
# PLATFORM_API_TOKEN=replace-with-a-distinct-random-token-at-least-32-characters-long
# PLATFORM_AGENT_TOKEN=replace-with-another-distinct-random-token-at-least-32-characters-long
